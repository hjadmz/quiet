{
  "name": "quiet",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.3",
  "postCreateCommand": "bundle install",
  "postAttachCommand": "bundle exec jekyll serve --host 0.0.0.0 --livereload",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": { "label": "quiet preview", "onAutoForward": "openPreview" }
  }
}
